{
  "name": "__MSG_ext_name__",
  "version": "1.0.0",
  "version_name": "1.0.0 (based on md-reader 2.12.12)",
  "author": "Bener (MIT) + local pro build",
  "manifest_version": 3,
  "description": "__MSG_ext_desc__",
  "default_locale": "en",
  "icons": {
    "16": "images/logo-pro-16.png",
    "32": "images/logo-pro-32.png",
    "48": "images/logo-pro-48.png",
    "128": "images/logo-pro-128.png",
    "512": "images/logo-pro-512.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["css/*", "fonts/*", "images/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_title": "MD Reader Pro",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/logo-pro-16.png",
      "32": "images/logo-pro-32.png",
      "48": "images/logo-pro-48.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["*://*/*", "file:///*"],
  "content_scripts": [
    {
      "js": ["js/content.js"],
      "css": ["css/content.css"],
      "matches": [
        "*://*/*.md",
        "*://*/*.mdx",
        "*://*/*.mkd",
        "*://*/*.markdown",
        "*://*/*.MD",
        "*://*/*.MDX",
        "*://*/*.MKD",
        "*://*/*.MARKDOWN",
        "file://*/*.md",
        "file://*/*.mdx",
        "file://*/*.mkd",
        "file://*/*.markdown",
        "file://*/*.MD",
        "file://*/*.MDX",
        "file://*/*.MKD",
        "file://*/*.MARKDOWN",
        "*://*/*.md?*",
        "*://*/*.mdx?*",
        "*://*/*.mkd?*",
        "*://*/*.markdown?*",
        "*://*/*.MD?*",
        "*://*/*.MDX?*",
        "*://*/*.MKD?*",
        "*://*/*.MARKDOWN?*",
        "file://*/*.md?*",
        "file://*/*.mdx?*",
        "file://*/*.mkd?*",
        "file://*/*.markdown?*",
        "file://*/*.MD?*",
        "file://*/*.MDX?*",
        "file://*/*.MKD?*",
        "file://*/*.MARKDOWN?*"
      ]
    },
    {
      "matches": ["file:///*/"],
      "js": ["js/dir-frame.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggleSide": {
      "description": "__MSG_command_toggle_side__",
      "suggested_key": {
        "default": "Alt+Shift+B"
      }
    },
    "toggleCentered": {
      "description": "__MSG_command_toggle_centered__",
      "suggested_key": {
        "default": "Alt+Shift+C"
      }
    },
    "toggleRefresh": {
      "description": "__MSG_command_toggle_refresh__",
      "suggested_key": {
        "default": "Alt+Shift+R"
      }
    },
    "toggleTheme": {
      "description": "__MSG_command_toggle_theme__",
      "suggested_key": {
        "default": "Alt+Shift+T"
      }
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
